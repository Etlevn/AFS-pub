# AFS environment variable template (v2)
#
# Usage:
#   cp .env.example .env
#   # Edit .env and enter your API keys (do not commit .env).
#
# Configure only the entries required by provider and data_vendors in config.py.
# main.py and test.py automatically load .env using python-dotenv at startup.

# -----------------------------------------------------------------------------
# LLM providers (select the matching provider in config.py)
# -----------------------------------------------------------------------------

# provider: openai
OPENAI_API_KEY=

# provider: deepseek
DEEPSEEK_API_KEY=

# provider: anthropic
ANTHROPIC_API_KEY=

# provider: google
GOOGLE_API_KEY=

# provider: xai
XAI_API_KEY=

# provider: qwen (Alibaba Cloud DashScope international compatible endpoint)
DASHSCOPE_API_KEY=

# provider: glm (Zhipu)
ZHIPU_API_KEY=

# provider: openrouter
OPENROUTER_API_KEY=

# provider: novaiapi
NOVAIAPI_API_KEY=

# provider: ollama — no API key required; run Ollama at http://localhost:11434

# -----------------------------------------------------------------------------
# Azure OpenAI (provider: azure)
# -----------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
OPENAI_API_VERSION=

# -----------------------------------------------------------------------------
# Market data (required when data_vendors in config.py uses alpha_vantage)
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=

# ALPHA_VANTAGE_API_KEY is optional when all data_vendors use yfinance.

# -----------------------------------------------------------------------------
# Optional: framework cache and historical log directories (default: ~/.tradingagents/)
# -----------------------------------------------------------------------------
# TRADINGAGENTS_CACHE_DIR=
# TRADINGAGENTS_RESULTS_DIR=
